<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- outer glow -->
    <path
        android:pathData="M54,54m-31,0a31,31 0,1 1,62 0a31,31 0,1 1,-62 0"
        android:fillColor="#2622D3EE" />
    <!-- ring, back half (behind the orb) -->
    <group android:rotation="-28" android:pivotX="54" android:pivotY="54">
        <path
            android:pathData="M16,54 a38,13 0 0 1 76,0"
            android:strokeWidth="3.4"
            android:strokeLineCap="round"
            android:strokeColor="#99C084FC" />
    </group>
    <!-- orb -->
    <path
        android:pathData="M54,54m-22,0a22,22 0,1 1,44 0a22,22 0,1 1,-44 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="46" android:centerY="44"
                android:gradientRadius="30"
                android:type="radial">
                <item android:color="#FFE8FEFF" android:offset="0.0" />
                <item android:color="#FF3EE6F5" android:offset="0.38" />
                <item android:color="#FF6D4DF2" android:offset="0.8" />
                <item android:color="#FF4B2AC9" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- download chevron carved into the orb -->
    <path
        android:pathData="M45,50 L54,59 L63,50"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeColor="#F2FFFFFF" />
    <!-- ring, front half (in front of the orb) -->
    <group android:rotation="-28" android:pivotX="54" android:pivotY="54">
        <path
            android:pathData="M16,54 a38,13 0 0 0 76,0"
            android:strokeWidth="3.4"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="16" android:startY="54"
                    android:endX="92" android:endY="54"
                    android:type="linear">
                    <item android:color="#FFFF5CCF" android:offset="0.0" />
                    <item android:color="#FF22E5FF" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
    <!-- sparkle -->
    <path
        android:pathData="M82,22 l1.8,5 l5,1.8 l-5,1.8 l-1.8,5 l-1.8,-5 l-5,-1.8 l5,-1.8 z"
        android:fillColor="#FFFFFFFF" />
